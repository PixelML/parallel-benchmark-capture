{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "event.schema.json",
  "title": "Parallel benchmark event",
  "type": "object",
  "required": ["schema_version", "event_type", "run_id", "elapsed_ms"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_type": { "enum": ["run.started", "stream.started", "stream.delta", "stream.completed", "stream.failed", "run.completed"] },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "elapsed_ms": { "type": "integer", "minimum": 0 },
    "run_mode": { "enum": ["LIVE", "REPLAY"] },
    "recipe": {
      "type": "object",
      "required": ["concurrency", "max_tokens", "model_label", "telemetry_mode"],
      "properties": {
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "model_label": { "type": "string", "maxLength": 80 },
        "telemetry_mode": { "enum": ["SSE CHUNK MODE", "EXACT SCHEDULER STEP"] }
      },
      "additionalProperties": false
    },
    "request_id": { "type": "string", "pattern": "^req_[a-z0-9][a-z0-9_-]{0,63}_\\d{2,4}$" },
    "stream_index": { "type": "integer", "minimum": 0, "maximum": 63 },
    "mode": { "enum": ["SSE CHUNK MODE", "EXACT SCHEDULER STEP"] },
    "sequence": { "type": "integer", "minimum": 0 },
    "text": { "type": "string", "maxLength": 12000 },
    "token_ids": { "type": "array", "maxItems": 4096, "items": { "type": "integer", "minimum": 0 } },
    "step_id": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["success", "usage_unavailable"] },
    "finish_reason": { "type": "string", "maxLength": 40 },
    "usage": {
      "type": ["object", "null"],
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
      "additionalProperties": false
    },
    "failure_kind": { "enum": ["http", "timeout", "wedge", "parse", "usage_unavailable", "telemetry", "unknown"] },
    "error_code": { "type": "string", "pattern": "^[a-z0-9_]{1,48}$" },
    "summary": { "$ref": "summary.schema.json" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_type": { "const": "run.started" } }, "required": ["event_type"] },
      "then": { "required": ["run_mode", "recipe"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "run.completed" } }, "required": ["event_type"] },
      "then": { "required": ["summary"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "stream.started" } }, "required": ["event_type"] },
      "then": { "required": ["request_id", "stream_index", "mode"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "stream.delta" } }, "required": ["event_type"] },
      "then": { "required": ["request_id", "stream_index", "mode", "sequence", "text", "token_ids"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "stream.completed" } }, "required": ["event_type"] },
      "then": { "required": ["request_id", "stream_index", "mode", "sequence", "status", "finish_reason", "usage"] }
    },
    {
      "if": { "properties": { "event_type": { "const": "stream.failed" } }, "required": ["event_type"] },
      "then": { "required": ["request_id", "stream_index", "mode", "sequence", "failure_kind", "error_code"] }
    }
  ],
  "additionalProperties": false
}
