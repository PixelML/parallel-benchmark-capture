{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "summary.schema.json",
  "title": "Parallel benchmark summary",
  "type": "object",
  "required": ["requested_concurrency", "active_count", "completed_count", "failed_count", "wall_time_ms", "total_completion_tokens", "aggregate_decode_tok_s", "ttft_ms", "completion_count", "throughput_distribution", "failure_labels", "winning_recipe"],
  "properties": {
    "requested_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
    "active_count": { "type": "integer", "minimum": 0 },
    "completed_count": { "type": "integer", "minimum": 0 },
    "failed_count": { "type": "integer", "minimum": 0 },
    "wall_time_ms": { "type": "integer", "minimum": 0 },
    "total_completion_tokens": { "type": "integer", "minimum": 0 },
    "aggregate_decode_tok_s": { "type": ["number", "null"], "minimum": 0 },
    "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
    "completion_count": { "type": "integer", "minimum": 0 },
    "throughput_distribution": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/throughput_distribution_entry" }
    },
    "failure_labels": {
      "type": "array",
      "maxItems": 16,
      "items": { "enum": ["http", "timeout", "wedge", "parse", "usage_unavailable", "telemetry", "unknown"] }
    },
    "winning_recipe": { "type": "string", "maxLength": 120 }
  },
  "$defs": {
    "throughput_distribution_entry": {
      "type": "object",
      "required": ["stream_index", "completion_tokens", "wall_time_ms", "tok_s", "status", "ttft_ms", "failure_kind"],
      "properties": {
        "stream_index": { "type": "integer", "minimum": 0, "maximum": 63 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "tok_s": { "type": ["number", "null"], "minimum": 0 },
        "status": { "enum": ["success", "failed"] },
        "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
        "failure_kind": { "type": ["string", "null"], "enum": ["http", "timeout", "wedge", "parse", "usage_unavailable", "telemetry", "unknown", null] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
