{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelml.example/schemas/parallel-benchmark-run-v1.json",
  "title": "Parallel benchmark run",
  "type": "object",
  "required": ["schema_version", "kind", "run_id", "run_mode", "events", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "benchmark.run" },
    "run_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" },
    "run_mode": { "enum": ["LIVE", "REPLAY"] },
    "events": { "type": "array", "items": { "$ref": "parallel-benchmark-event-v1.json" } },
    "summary": {
      "type": "object",
      "required": ["requested_concurrency", "completed_count", "failed_count", "wall_time_ms", "total_completion_tokens", "aggregate_decode_tok_s", "ttft_ms", "completion_count", "throughput_distribution", "failure_labels", "winning_recipe"],
      "properties": {
        "requested_concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "active_count": { "type": "integer", "minimum": 0 },
        "completed_count": { "type": "integer", "minimum": 0 },
        "failed_count": { "type": "integer", "minimum": 0 },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "total_completion_tokens": { "type": "integer", "minimum": 0 },
        "aggregate_decode_tok_s": { "type": ["number", "null"], "minimum": 0 },
        "ttft_ms": { "type": ["number", "null"], "minimum": 0 },
        "completion_count": { "type": "integer", "minimum": 0 },
        "throughput_distribution": { "type": "array" },
        "failure_labels": { "type": "array", "items": { "type": "string" } },
        "winning_recipe": { "type": "string", "maxLength": 120 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
